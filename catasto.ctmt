::kind(catasto, version: "0.1.0")
::upstream(
  commonfiles: catasto.git("https://github.com/tomet-lang/commonfiles.git", rev: main, path: base)
  fs_catasto:  catasto.git("https://github.com/tomet-lang/fs-catasto.git", rev: main, path: "tmtroot/schema")
)

// Schema
".tomet/schema/catasto@0.1.0.vocabulary.tmt": catasto.upstream(fs_catasto, path: "catasto@0.1.0.vocabulary.tmt")
".tomet/schema/catasto@0.1.0.blueprint.ctmt": catasto.upstream(fs_catasto, path: "catasto@0.1.0.blueprint.ctmt")

// Environment
".editorconfig":  catasto.upstream(commonfiles, path: ".editorconfig")
".gitattributes": catasto.upstream(commonfiles, path: ".gitattributes")
"LICENSE-APACHE": catasto.upstream(commonfiles, path: "LICENSE-APACHE")
"LICENSE-MIT":    catasto.upstream(commonfiles, path: "LICENSE-MIT")
