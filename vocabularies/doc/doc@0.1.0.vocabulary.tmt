::kind(vocabulary)
::vocabulary(doc, version: "0.1.0")
::element(
  index: (
    display: block
    singleton: false
    args: (
      id: (
        type: string
        positional: true
        about: | The rule's identifier. The heading is prose and may be reworded; this
               | identifier is the name a tool is held to.
  )))
  icon: (
    display: block
    singleton: false
    args: (
      name: (type: string, positional: true)
      pkg:  (type: string, positional: true)
  ))
  kbd: (
    display: block
    singleton: false
    args: (
      key: (type: string, positional: true)
)))
